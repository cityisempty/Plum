PORT=8787
DATABASE_PATH=./data/plum.db
JWT_SECRET=change-me-to-a-long-random-string
JWT_TTL=2h
ADMIN_INIT_USERNAME=admin
ADMIN_INIT_PASSWORD=change-me-admin-pass
REGISTER_BONUS_POINTS=100
COOKIE_SECURE=false
NODE_ENV=development

# 微信公众号网页授权（服务号）。本地开发可开 WECHAT_MOCK=true 跳过真实 OAuth。
WECHAT_APP_ID=
WECHAT_APP_SECRET=
WECHAT_MOCK=true
PUBLIC_BASE_URL=http://localhost:5173

# 决策模型由 Plum Node 服务端直接调用，密钥只放在 server/.env，绝不进入浏览器。
MODEL_PRIORITY=gemini,openai,custom
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash-exp
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
CUSTOM_API_KEY=
CUSTOM_BASE_URL=
CUSTOM_MODEL=gpt-3.5-turbo
# 未配置上游模型时，本地以模拟流测试统一点数扣减；生产环境请设为 false。
DECISION_LOCAL_MOCK=true
